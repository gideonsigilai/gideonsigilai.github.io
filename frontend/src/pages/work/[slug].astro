---
import Layout from '../../layouts/Layout.astro';
import { API_BASE, apiFetch } from "../../lib/api";
import { imageUrl } from "../../lib/images";

export async function getStaticPaths() {
  const res = await apiFetch('/api/projects');
  return (res.projects || []).map((p: any) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const res = await apiFetch(`/api/projects/${slug}`);
const project = res.project;
const projectImage = await imageUrl(project.image ? project.image : `${API_BASE}/images/work/${project.slug}.svg`);
const others = res.others || [];
const site = await apiFetch('/api/site');
const initials = site.profile.name.split(' ').map((w: string) => w[0]).join('').slice(0,2).toUpperCase();
const socialsHtml = (site.socials || []).map((s: any) => `<a class="social-link" href="${s.href}" rel="noopener noreferrer me" target="_blank">${s.label}</a>`).join('');
const nav = [
  { href: '/', label: 'Home', short: 'Home' },
  { href: '/#work', label: 'Work', short: 'Work', active: true },
  { href: '/writing', label: 'Writing', short: 'Writing' },
  { href: '/#contact', label: 'Contact', short: 'Contact', contact: true },
];
const features = project.features || [];
const story = project.story || [];
const outcome = project.outcome || [];
const stackChips = (project.stack || []).map((s: string) => `<span class="chip" role="listitem">${s}</span>`).join('');
const socialRow = socialsHtml;
const canonical = Astro.site ? new URL(`/work/${slug}`, Astro.site).href : `/work/${slug}`;
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'CreativeWork', name: project.name, description: project.summary, url: canonical, author: { '@type': 'Person', name: site.profile.name }, keywords: (project.stack || []).join(', ') });
const headExtra = '<script type="application/ld+json">' + jsonLd + '</script>';
const link = project.link;
---
<Layout title={`${project.name} — ${site.profile.name}`} description={project.summary} canonical={canonical} apiBase={API_BASE} siteName={site.profile.name} initials={initials} jobTitle={site.profile.job_title} location={site.profile.location} nav={nav} socials={socialsHtml} year={new Date().getFullYear()} headExtra={headExtra}>
  <article class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href="/#work">Work</a><span aria-hidden="true">/</span>
      <span aria-current="page">{project.name}</span>
    </nav>
    <header class="detail-hero">
      <p class="eyebrow">{project.category_label}</p>
      <h1>{project.name}{project.playstore && <> <a class="text-link" href={project.playstore_href} target="_blank" rel="noopener noreferrer">Google Play ↗</a></>}</h1>
      <p class="detail-summary">{project.summary}</p>
      <p class="article-byline">A project by <a href="/#about">{site.profile.name}</a></p>
      <div class="tag-row detail-stack" role="list" aria-label={`Technologies used in ${project.name}`} set:html={stackChips}></div>
      <dl class="project-facts">
        <div><dt>Role</dt><dd>{project.role}</dd></div>
        <div><dt>Timeline</dt><dd>{project.year}</dd></div>
        <div><dt>Status</dt><dd>{project.status}</dd></div>
        <div><dt>Stack</dt><dd>{project.stack_line}</dd></div>
      </dl>
      <figure class={`project-art detail-art art--${project.accent}`}>
        <img class="cover-art" src={projectImage} width="1200" height="630" loading="eager" fetchpriority="high" decoding="async" alt={project.image_alt} />
        <figcaption class="sr-only">{project.tagline}</figcaption>
      </figure>
    </header>
    <div class="detail-layout">
      <div>
        <section aria-labelledby="story-heading">
          <h2 id="story-heading">The problem</h2>
          {story.map((s: string) => <p set:html={s}></p>)}
        </section>
        <section aria-labelledby="features-heading">
          <h2 id="features-heading">What&rsquo;s inside</h2>
          <div class="feature-list">
            {features.map((f: any) => (
              <div class="feature-item"><h3>{f.title}</h3><p>{f.detail}</p></div>
            ))}
          </div>
        </section>
        <section aria-labelledby="outcome-heading">
          <h2 id="outcome-heading">What came out of it</h2>
          <ul class="tick-list">{outcome.map((o: string) => <li set:html={o}></li>)}</ul>
          {link && <a class="btn btn--lime btn--sm" href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>}
        </section>
        <section aria-labelledby="next-heading">
          <h2 id="next-heading">Next project</h2>
          <div class="next-projects">
            {others.map((o: any) => (
              <a class="next-card" href={`/work/${o.slug}`}>
                <span class="label">{o.category_label || o.category}</span>
                <strong>{o.name}</strong>
                <span class="small muted">{o.summary}</span>
              </a>
            ))}
          </div>
        </section>
      </div>
      <aside class="post-aside">
        <div class="aside-card">
          <p class="eyebrow">From idea to outcome</p>
          <h2>{project.name}</h2>
          <p>{project.summary}</p>
          <button class="text-link" type="button" data-share>Share this project ↗</button>
        </div>
        <div class="aside-card">
          <h2>Start a conversation</h2>
          <p>Building something in this space? I&rsquo;d like to hear about it.</p>
          <a class="btn btn--lime btn--sm" href="/#contact" data-contact>Get in touch</a>
        </div>
        <div class="aside-card">
          <h2>Elsewhere</h2>
          <div set:html={socialRow}></div>
        </div>
      </aside>
    </div>
  </article>
</Layout>
