---
import Layout from '../../layouts/Layout.astro';
import { API_BASE, apiFetch } from "../../lib/api";
import { toDataUri } from "../../lib/images";

const postsRes = await apiFetch('/api/posts');
const postsRaw = postsRes.posts || [];
const posts = await Promise.all(postsRaw.map(async (p: any) => ({
  ...p,
  cover_image: p.cover_image ? await toDataUri(p.cover_image) : await toDataUri(`${API_BASE}/images/writing/${p.slug}.svg`),
})));

const site = await apiFetch('/api/site');
const author = site.profile.name;
const jobTitle = site.profile.job_title;
const location = site.profile.location;
const initials = site.profile.name.split(' ').map((w: string) => w[0]).join('').slice(0,2).toUpperCase();
const socialsHtml = (site.socials || []).map((s: any) => `<a class="social-link" href="${s.href}" rel="noopener noreferrer me" target="_blank">${s.label}</a>`).join('');
const nav = [
  { href: '/', label: 'Home', short: 'Home' },
  { href: '/#work', label: 'Work', short: 'Work' },
  { href: '/writing', label: 'Writing', short: 'Writing', active: true },
  { href: '/#contact', label: 'Contact', short: 'Contact', contact: true },
];
const fmt = (d: string) => { try { return new Date(d).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' }); } catch { return d; } };
const canonical = Astro.site ? new URL('/writing', Astro.site).href : '/writing';
---
<Layout title={`Writing — ${site.profile.name}`} description="Engineering notes" canonical={canonical} apiBase={API_BASE} siteName={site.profile.name} initials={initials} jobTitle={jobTitle} location={location} nav={nav} socials={socialsHtml} year={new Date().getFullYear()}>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <span aria-current="page">Writing</span>
    </nav>
    <header class="journal-hero">
      <p class="eyebrow">Engineering notes</p>
      <h1>Notes from<br>the <span class="serif">build.</span></h1>
      <div class="journal-lead">
        <p>Architecture decisions, security tradeoffs, and the practices that keep a product honest. Written by <a href="/#about">{author}</a> while shipping, not after.</p>
        <a class="text-link" href="/rss.xml">Subscribe via RSS ↗</a>
      </div>
    </header>
    <section class="journal-index" aria-label="All posts">
      {posts.length > 0 ? (
        <>
          <div class="journal-controls">
            <div class="journal-filters" data-journal-filters role="group" aria-label="Filter notes by tag">
              <button class="chip" type="button" data-journal-filter="all" aria-pressed="true">All notes</button>
            </div>
            <div class="journal-search">
              <label for="journal-search">Search notes</label>
              <input id="journal-search" data-journal-search type="search" placeholder="Find a note…" autocomplete="off" />
            </div>
          </div>
          <p class="journal-count" data-journal-count role="status" aria-live="polite">All published notes</p>
          <div class="journal-grid">
            {posts.map((p: any) => (
              <article class="journal-card" data-post>
                <a class="journal-visual" href={`/writing/${p.slug}`} aria-label={`Read ${p.title}`}>
                  <img class="cover-art" src={p.cover_image || `${API_BASE}/images/writing/${p.slug}.svg`} width="1200" height="630" loading="lazy" decoding="async" alt={p.image_alt || p.title} />
                </a>
                <div class="journal-meta">
                  <time datetime={p.published_at}>{fmt(p.published_at)}</time>
                  <span>{p.reading_min} min read</span>
                </div>
                <h2><a href={`/writing/${p.slug}`}>{p.title}</a></h2>
                <p>{p.excerpt}</p>
                <div class="tag-row" data-journal-tags role="list" aria-label={`Topics covered in ${p.title}`}>
                  {(p.tags || []).map((t: string) => <span class="chip" role="listitem">{t}</span>)}
                </div>
                <a class="text-link" href={`/writing/${p.slug}`}>Read note <span class="sr-only">— {p.title}</span><span aria-hidden="true">↗</span></a>
              </article>
            ))}
          </div>
          <div class="detail-empty" data-journal-empty hidden>
            <h2>No matching notes.</h2>
            <p>Try a different search or explore all the notes.</p>
            <button class="btn btn--ghost" type="button" data-journal-reset>Show all notes</button>
          </div>
        </>
      ) : (
        <div class="detail-empty">
          <h2>No published notes yet.</h2>
          <p>Posts appear here as soon as they are published from the dashboard. The RSS feed is the fastest way to know when the first one lands.</p>
          <a class="text-link" href="/rss.xml">RSS feed</a>
        </div>
      )}
    </section>
    <section class="journal-cta" aria-labelledby="journal-topic">
      <h2 id="journal-topic">Something on your mind?</h2>
      <a class="text-link" href="/#contact" data-contact>Suggest a topic ↗</a>
    </section>
  </div>
</Layout>
