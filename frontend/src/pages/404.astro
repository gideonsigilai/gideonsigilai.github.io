---
import Layout from '../layouts/Layout.astro';
const nav = [
  { href: '/', label: 'Home', short: 'Home' },
  { href: '/#work', label: 'Work', short: 'Work' },
  { href: '/writing', label: 'Writing', short: 'Writing' },
  { href: '/#contact', label: 'Contact', short: 'Contact', contact: true },
];
---
<Layout title="Not found" description="Page not found" noindex={true} nav={nav} siteName="Gideon Sigilai" initials="GS" year={new Date().getFullYear()}>
  <div class="wrap not-found">
    <p class="eyebrow">404</p>
    <h1>Page <span class="serif">not found.</span></h1>
    <p class="detail-summary">The page you are looking for does not exist.</p>
    <div class="detail-actions">
      <a class="btn btn--lime" href="/">Back home</a>
      <a class="btn btn--ghost" href="/writing">Read the writing</a>
      <a class="btn btn--ghost" href="/#contact" data-contact>Get in touch</a>
    </div>
  </div>
</Layout>
